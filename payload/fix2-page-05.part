';
 const hex=b=>[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('');
 const fromB64=s=>{const b=atob(s),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);return a};
 const ungzip=async b=>new Response(new Blob([b]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();
 const fetchEncoded=async(files,label)=>{const chunks=[];for(let i=0;i<files.length;i++){status.textContent=`${label} ${i+1}/${files.length}…`;const r=await fetch(`${files[i]}?v=${version}`,{cache:'no-store'});if(!r.ok)throw new Error(`Fichier manquant : ${files[i]} (${r.status})`);chunks.push(await r.text())}return fromB64(chunks.join('').replace(/\s+/g,''))};
 const nodes=root=>{const a=[],w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);for(let n=w.nextNode();n;n=w.nextNode())a.push(n);return a};
